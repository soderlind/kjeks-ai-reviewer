#. Plugin Name of the plugin
#: kjeks-ai-reviewer.php
msgid "Kjeks AI Reviewer"
msgstr "Kjeks AI Reviewer"

#. Plugin URI of the plugin
#: kjeks-ai-reviewer.php
msgid "https://github.com/soderlind/kjeks-ai-reviewer"
msgstr "https://github.com/soderlind/kjeks-ai-reviewer"

#. Description of the plugin
#: kjeks-ai-reviewer.php
msgid "On WordPress 7+, uses the core AI client to suggest classifications and enriched metadata for unreviewed cookies in the Kjeks registry. Suggestions are advisory; an administrator confirms every one."
msgstr "På WordPress 7+ bruker den kjernens AI-klient til å foreslå klassifiseringer og utfyllende metadata for ubehandlede informasjonskapsler i Kjeks-registeret. Forslagene er veiledende; en administrator bekrefter hvert enkelt."

#. Author of the plugin
#: kjeks-ai-reviewer.php
msgid "Per Søderlind"
msgstr "Per Søderlind"

#. Author URI of the plugin
#: kjeks-ai-reviewer.php
msgid "https://soderlind.no"
msgstr "https://soderlind.no"

#: src/AiClient.php:32
#: src/Rest/SuggestController.php:95
msgid "This site does not support the AI client."
msgstr "Dette nettstedet støtter ikke AI-klienten."

#: src/AiClient.php:36
msgid "The AI client is not available."
msgstr "AI-klienten er ikke tilgjengelig."

#: src/AiReviewer.php:76
msgid "No suggestion exists for this tracker."
msgstr "Det finnes ingen forslag for denne sporeren."

#: src/AiReviewer.php:81
msgid "Invalid category."
msgstr "Ugyldig kategori."

#: src/AiReviewer.php:87
msgid "The tracker no longer exists."
msgstr "Sporeren finnes ikke lenger."

#: src/Plugin.php:54
msgid "Kjeks AI Reviewer requires the Kjeks plugin to be active."
msgstr "Kjeks AI Reviewer krever at Kjeks-utvidelsen er aktiv."

#: src/Reviewer.php:94
msgid "Matched a known entry in the Open Cookie Database."
msgstr "Samsvarte med en kjent oppføring i Open Cookie Database."

#: src/SchemaValidator.php:32
msgid "The model did not return valid JSON."
msgstr "Modellen returnerte ikke gyldig JSON."

#: src/SchemaValidator.php:48
msgid "The suggestion confidence was too low; leaving for manual review."
msgstr "Forslaget hadde for lav sikkerhet; overlates til manuell gjennomgang."

